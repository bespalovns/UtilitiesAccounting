    Функция РассчитатьНачисление() Экспорт

    Если Не ЗначениеЗаполнено(Квартира) Тогда
        Сообщить("Выберите квартиру.");
        Возврат Ложь;
    КонецЕсли;

    Если Не ЗначениеЗаполнено(Услуга) Тогда
        Сообщить("Выберите услугу.");
        Возврат Ложь;
    КонецЕсли;

    Если Не ЗначениеЗаполнено(ПериодНачисления) Тогда
        Сообщить("Укажите месяц начисления.");
        Возврат Ложь;
    КонецЕсли;

    Если Тариф <= 0 Тогда
        Сообщить("Тариф должен быть больше нуля.");
        Возврат Ложь;
    КонецЕсли;

    Если ПоСчетчику Тогда

        Если ПредыдущееПоказание < 0
            Или ТекущееПоказание < 0 Тогда

            Сообщить("Показания не могут быть отрицательными.");
            Возврат Ложь;

        КонецЕсли;

        Если ТекущееПоказание < ПредыдущееПоказание Тогда
            Сообщить(
                "Текущее показание не может быть меньше предыдущего."
            );
            Возврат Ложь;
        КонецЕсли;

        РасчетноеКоличество =
            ТекущееПоказание - ПредыдущееПоказание;

    Иначе

        Если Количество <= 0 Тогда
            Сообщить("Количество должно быть больше нуля.");
            Возврат Ложь;
        КонецЕсли;

        РасчетноеКоличество = Количество;

    КонецЕсли;

    РасчетнаяСумма = Окр(РасчетноеКоличество * Тариф, 2);

    Если Оплачено < 0 Тогда
        Сообщить("Оплаченная сумма не может быть отрицательной.");
        Возврат Ложь;
    КонецЕсли;

    Если Оплачено > РасчетнаяСумма Тогда
        Сообщить(
            "В этой версии оплаченная сумма не может "
            + "превышать начисленную."
        );
        Возврат Ложь;
    КонецЕсли;

    ПериодНачисления = НачалоМесяца(ПериодНачисления);
    Количество = РасчетноеКоличество;
    Сумма = РасчетнаяСумма;
    Остаток = Окр(Сумма - Оплачено, 2);

    Возврат Истина;

КонецФункции


Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)

    Если ОбменДанными.Загрузка Тогда
        Возврат;
    КонецЕсли;

    Если Не РассчитатьНачисление() Тогда
        Отказ = Истина;
    КонецЕсли;

КонецПроцедуры